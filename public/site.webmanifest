{
  "name": "OmniScore - Todos os Esportes em Tempo Real",
  "short_name": "OmniScore",
  "description": "Acompanhe resultados ao vivo de todos os esportes: futebol, basquete, hóquei, vôlei, natação, jiu-jitsu, judô, MMA e tênis em tempo real no OmniScore.",
  "start_url": "./",
  "display": "standalone",
