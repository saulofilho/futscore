# ==========================================
# GEMINI AI (Análise Tática & IA)
# ==========================================
# GEMINI_API_KEY: Necessária para análises com IA no servidor e previsões estatísticas
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde a aplicação está hospedada (ex: https://omniscore.vercel.app)
APP_URL="MY_APP_URL"

# ==========================================
# GOOGLE ADSENSE (Monetização & Banners)
# ==========================================
# VITE_ADSENSE_CLIENT_ID: Seu identificador de editor do Google AdSense
# Formato: ca-pub-XXXXXXXXXXXXXXXX (16 dígitos)
# Encontrado no painel do AdSense > Conta > Informações da conta > ID de editor
VITE_ADSENSE_CLIENT_ID=""

# VITE_ADSENSE_SLOT_TOP_BANNER: ID do bloco de anúncios para o banner superior
VITE_ADSENSE_SLOT_TOP_BANNER=""

# VITE_ADSENSE_SLOT_FEED: ID do bloco de anúncios exibido entre os jogos
VITE_ADSENSE_SLOT_FEED=""

# VITE_ADSENSE_SLOT_MODAL: ID do bloco de anúncios dentro do modal de detalhes da partida
VITE_ADSENSE_SLOT_MODAL=""

# VITE_ADSENSE_TEST_MODE: Quando 'true' ou em localhost, exibe molduras elegantes simuladas
# para validação do layout sem gerar impressões inválidas no Google AdSense
VITE_ADSENSE_TEST_MODE="true"
